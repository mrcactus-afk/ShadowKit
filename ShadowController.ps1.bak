<#
.SYNOPSIS
    Master Controller - runs component scripts on a schedule (no background jobs).
.DESCRIPTION
    Reads config, then enters an infinite loop. At each cycle, it checks if it's time
    to run each enabled component (based on last run time + interval). It runs the
    script using Start-Process -Wait, logs the result, and updates the last run time.
.PARAMETER Silent
    Suppresses console output.
#>

param([switch]$Silent)

# ---- paths ----
$scriptDir = "C:\\ShadowKit"
$configPath = Join-Path $scriptDir "config.json"
$logDir = Join-Path $scriptDir "logs"
$componentsDir = Join-Path $scriptDir "components"
if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir -Force | Out-Null }
$logFile = Join-Path $logDir "master_$(Get-Date -Format 'yyyy-MM-dd').log"

# ---- config ----
if (-not (Test-Path $configPath)) { Write-Error "Config missing"; exit 1 }
$config = Get-Content $configPath | ConvertFrom-Json

function Write-MasterLog {
    param($Message, $Level = "info")
    $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "[$ts] [$Level] $Message"
    $entry | Out-File -Append $logFile
    if (-not $Silent) {
        if ($Level -eq "error") { Write-Host $entry -ForegroundColor Red }
        else { Write-Host $entry -ForegroundColor Cyan }
    }
}

# ---- define components to run ----
$components = @()
if ($config.watchdog.enabled) {
    $components += @{
        Name = "Watchdog"
        Script = Join-Path $componentsDir "System-System-Watchdog.ps1"
        IntervalMinutes = $config.watchdog.intervalMinutes
        LastRun = (Get-Date).AddDays(-1)  # force first run
    }
}
if ($config.dns.enabled) {
    $components += @{
        Name = "DNSFrenzy"
        Script = Join-Path $componentsDir "DNS-Switcher.ps1"
        IntervalMinutes = $config.dns.intervalMinutes
        LastRun = (Get-Date).AddDays(-1)
    }
}
if ($config.memory.enabled) {
    $components += @{
        Name = "MemoryCleaner"
        Script = Join-Path $componentsDir "Memory-Purge.ps1"
        IntervalMinutes = $config.memory.intervalMinutes
        LastRun = (Get-Date).AddDays(-1)
    }
}

if ($components.Count -eq 0) { Write-MasterLog "No components enabled. Exiting." "error"; exit 1 }

Write-MasterLog "Master Controller started - will run components on schedule."

# ---- main loop ----
while ($true) {
    $now = Get-Date
    foreach ($comp in $components) {
        $elapsed = ($now - $comp.LastRun).TotalMinutes
        if ($elapsed -ge $comp.IntervalMinutes) {
            Write-MasterLog "Running $($comp.Name) (last run ${elapsed:N1} min ago, interval $($comp.IntervalMinutes) min)"
            try {
                $proc = Start-Process -FilePath "powershell.exe" -ArgumentList "-ExecutionPolicy Bypass -File `"$($comp.Script)`" -Silent" -Wait -PassThru -WindowStyle Hidden
                $exit = $proc.ExitCode
                if ($exit -eq 0) {
                    Write-MasterLog "$($comp.Name) completed successfully (exit 0)."
                } else {
                    Write-MasterLog "$($comp.Name) exited with code $exit." "warn"
                }
            } catch {
                Write-MasterLog "Failed to start $($comp.Name): $_" "error"
            }
            # Update last run time regardless of success/failure
            $comp.LastRun = $now
        }
    }
    # Sleep for a short period before checking again (e.g., 30 seconds)
    Start-Sleep -Seconds 30
}